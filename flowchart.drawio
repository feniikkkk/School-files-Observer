        <Array as="points">
          <mxPoint x="420" y="610" />
          <mxPoint x="420" y="640" />
        </Array>
      </mxGeometry>
    </mxCell>

    <mxCell id="node_move" value="Move to Target&#xa;Module Folder" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
      <mxGeometry x="340" y="740" width="160" height="60" as="geometry" />
